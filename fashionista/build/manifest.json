    "https://www.zara.com/*",
    "https://www2.hm.com/*",
    "https://www.asos.com/*",
    "https://www.nike.com/*",
    "https://www.adidas.com/*",
    "https://www.uniqlo.com/*",
    "https://www.shein.com/*",
    "https://www.myntra.com/*",
    "https://www.forever21.com/*",
    "https://www.macys.com/*",
