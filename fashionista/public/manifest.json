{
  "manifest_version": 3,
  "name": "ZYORA",
  "version": "1.0.3",
  "description": "Fashion Virtual Try On Extension",
  "permissions": ["activeTab","sidePanel", "storage", "identity", "contextMenus"],
  "oauth2": {
    "client_id": "943615009192-s6usr3jtaraqcg9a2arrjvncsrvagtbj.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open ZYORA"
  },
  "icons": {
    "16": "Z.png",
    "32": "Z.png",
    "48": "Z.png",
    "128": "Z.png"
  }
}


